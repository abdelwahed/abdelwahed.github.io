---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-8">
  <h2 class="font-serif text-2xl md:text-3xl font-bold text-slate-800 relative inline-block">
    {title}
    <span class="absolute -bottom-2 left-0 w-12 h-1 bg-amber-500 rounded-full"></span>
  </h2>
  {subtitle && (
    <p class="mt-4 text-slate-600">{subtitle}</p>
  )}
</div>


