---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Research Scientist at CSIRO Data61" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/images/favicon.png" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  
  <title>{title}</title>
</head>
<body class="bg-stone-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
  <!-- Header -->
  <header class="sticky top-0 left-0 right-0 z-50 bg-slate-850 shadow-lg">
    <nav class="max-w-6xl mx-auto px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo/Name for mobile -->
        <a href="/" class="md:hidden text-white font-mono font-semibold text-lg">AK</a>
        
        <!-- Hamburger button (mobile only) -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden text-stone-300 hover:text-white p-2"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
        
        <!-- Desktop Navigation -->
        <ul class="hidden md:flex items-center justify-center gap-8 w-full">
          <li>
            <a 
              href="/" 
              class:list={[
                "px-4 py-2 text-sm font-medium tracking-wide uppercase transition-all duration-200",
                currentPath === "/" || currentPath === "/index.html" 
                  ? "text-amber-400 border-b-2 border-amber-400" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50 rounded"
              ]}
            >
              Home
            </a>
          </li>
          <li>
            <a 
              href="/publications" 
              class:list={[
                "px-4 py-2 text-sm font-medium tracking-wide uppercase transition-all duration-200",
                currentPath.includes("/publications")
                  ? "text-amber-400 border-b-2 border-amber-400" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50 rounded"
              ]}
            >
              Publications
            </a>
          </li>
          <li>
            <a 
              href="/lectures" 
              class:list={[
                "px-4 py-2 text-sm font-medium tracking-wide uppercase transition-all duration-200",
                currentPath.includes("/lectures")
                  ? "text-amber-400 border-b-2 border-amber-400" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50 rounded"
              ]}
            >
              Talks
            </a>
          </li>
          <li>
            <a 
              href="/videos" 
              class:list={[
                "px-4 py-2 text-sm font-medium tracking-wide uppercase transition-all duration-200",
                currentPath.includes("/videos")
                  ? "text-amber-400 border-b-2 border-amber-400" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50 rounded"
              ]}
            >
              Videos
            </a>
          </li>
        </ul>
      </div>
      
      <!-- Mobile Navigation Menu -->
      <div id="mobile-menu" class="md:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0">
        <ul class="flex flex-col gap-2 pb-4">
          <li>
            <a 
              href="/" 
              class:list={[
                "block px-4 py-3 text-sm font-medium tracking-wide uppercase transition-all duration-200 rounded",
                currentPath === "/" || currentPath === "/index.html" 
                  ? "text-amber-400 bg-slate-700/50" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50"
              ]}
            >
              Home
            </a>
          </li>
          <li>
            <a 
              href="/publications" 
              class:list={[
                "block px-4 py-3 text-sm font-medium tracking-wide uppercase transition-all duration-200 rounded",
                currentPath.includes("/publications")
                  ? "text-amber-400 bg-slate-700/50" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50"
              ]}
            >
              Publications
            </a>
          </li>
          <li>
            <a 
              href="/lectures" 
              class:list={[
                "block px-4 py-3 text-sm font-medium tracking-wide uppercase transition-all duration-200 rounded",
                currentPath.includes("/lectures")
                  ? "text-amber-400 bg-slate-700/50" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50"
              ]}
            >
              Talks
            </a>
          </li>
          <li>
            <a 
              href="/videos" 
              class:list={[
                "block px-4 py-3 text-sm font-medium tracking-wide uppercase transition-all duration-200 rounded",
                currentPath.includes("/videos")
                  ? "text-amber-400 bg-slate-700/50" 
                  : "text-stone-300 hover:text-white hover:bg-slate-700/50"
              ]}
            >
              Videos
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </header>
  
  <script>
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    
    let isOpen = false;
    
    menuBtn?.addEventListener('click', () => {
      isOpen = !isOpen;
      
      if (isOpen) {
        // Expand: set max-height to scrollHeight for smooth animation
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
      } else {
        // Collapse: animate back to 0
        mobileMenu.style.maxHeight = '0px';
      }
      
      menuIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });
  </script>

  <!-- Main Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-slate-850 text-stone-400 py-8 mt-16">
    <div class="max-w-6xl mx-auto px-6 text-center">
      <p class="text-sm">
        © {new Date().getFullYear()} Abdelwahed Khamis. Built with 
        <a href="https://astro.build" class="text-amber-400 hover:text-amber-300 transition-colors">Astro</a>.
      </p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  /* Smooth scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f5f9;
  }
  ::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #64748b;
  }

  /* Selection color */
  ::selection {
    background-color: #d97706;
    color: white;
  }

  /* Custom underline for links in content */
  .prose a {
    text-decoration-color: #d97706;
    text-underline-offset: 3px;
  }
</style>

