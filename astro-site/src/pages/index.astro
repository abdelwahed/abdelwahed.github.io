---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsItem from '../components/NewsItem.astro';

import siteData from '../data/site.json';
import newsData from '../data/news.json';

const allNews = newsData.items;
---

<BaseLayout title={`${siteData.name} | Research Scientist`}>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <!-- Hero Section -->
    <section class="grid md:grid-cols-3 gap-12 mb-16">
      <!-- Profile Card -->
      <div class="md:col-span-1">
        <div class="sticky top-24">
          <!-- Profile Image -->
          <div class="relative mb-6 group flex justify-center">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-amber-200 to-orange-300 rounded-full transform scale-105 group-hover:scale-110 transition-transform duration-300"></div>
              <img 
                src={siteData.avatar} 
                alt={siteData.name}
                class="relative w-48 h-48 md:w-56 md:h-56 rounded-full shadow-xl object-cover border-4 border-white"
              />
            </div>
          </div>

          <!-- Name -->
          <h1 class="font-mono text-2xl font-bold text-slate-800 mb-3 text-center">
            {siteData.name}
          </h1>
          
          <!-- Positions -->
          <div class="mb-3 space-y-0.5 text-center">
            <p class="text-sm text-slate-700">Research Scientist, Data61, CSIRO</p>
            <p class="text-sm text-slate-700">Adjunct Fellow, QUT</p>
          </div>

          <!-- Contact -->
          <div class="text-center mb-4 space-y-1">
            <p class="text-sm text-slate-600">
              <span class="select-all">{siteData.email.replace('@', ' [at] ')}</span>
            </p>
            <p class="text-xs text-slate-500">{siteData.location}</p>
          </div>

          <!-- Social Links -->
          <div class="flex justify-center gap-3">
            <a 
              href={siteData.scholar} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 text-slate-600 hover:bg-amber-500 hover:text-white transition-all duration-300"
              title="Google Scholar"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
              </svg>
            </a>
            <a 
              href={siteData.linkedin} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 text-slate-600 hover:bg-amber-500 hover:text-white transition-all duration-300"
              title="LinkedIn"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="md:col-span-2 space-y-16">
        <!-- About -->
        <section>
          <div 
            class="prose prose-lg max-w-none text-slate-700 leading-relaxed"
            set:html={siteData.introduction}
          />
        </section>

        <!-- News -->
        <section>
          <SectionHeading title="News" />
          <div class="space-y-3">
            {allNews.map((item, index) => (
              <NewsItem {...item} index={index} />
            ))}
          </div>
        </section>

        <!-- Publications -->
        <section>
          <SectionHeading title="Publications" />
          <p class="text-slate-700 leading-relaxed">
            My research focuses on Cyber-Physical Systems, including Radio-based Sensing, Machine Learning for IoT, and Optimal Transport methods. 
            I have published in top-tier venues such as <span class="font-semibold text-slate-800">SenSys</span>, <span class="font-semibold text-slate-800">PerCom</span>, <span class="font-semibold text-slate-800">ICCV</span>, <span class="font-semibold text-slate-800">IJCAI</span>, <span class="font-semibold text-slate-800">IEEE TPAMI</span>, <span class="font-semibold text-slate-800">IEEE Communications Surveys & Tutorials</span>, and <span class="font-semibold text-slate-800">Artificial Intelligence Review</span>.
            <a 
              href="/publications" 
              class="text-amber-600 hover:text-amber-500 font-medium transition-colors inline-flex items-center gap-1"
            >
              See all publications →
            </a>
          </p>
        </section>

        <!-- Students -->
        <section>
          <SectionHeading title="Students & Team" />
          <div class="space-y-2">
            {siteData.team.map((member) => (
              <div class="flex flex-wrap items-baseline gap-x-2 text-sm">
                <span class="font-semibold text-slate-800">{member.name}</span>
                <span class="text-slate-500">—</span>
                <span class="text-slate-600">{member.role}</span>
                <span class="text-slate-400 text-xs">({member.period})</span>
                {member.project && <span class="text-amber-600 text-xs">{member.project}</span>}
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>
