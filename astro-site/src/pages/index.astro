---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsItem from '../components/NewsItem.astro';

import siteData from '../data/site.json';
import newsData from '../data/news.json';

const allNews = newsData.items;
---

<BaseLayout title={`${siteData.name} | Research Scientist`}>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <!-- Hero Section -->
    <section class="grid md:grid-cols-3 gap-12 mb-16">
      <!-- Profile Card -->
      <div class="md:col-span-1">
        <div class="sticky top-24">
          <!-- Profile Image -->
          <div class="relative mb-6 group flex justify-center">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-amber-200 to-orange-300 rounded-full transform scale-105 group-hover:scale-110 transition-transform duration-300"></div>
              <img 
                src={siteData.avatar} 
                alt={siteData.name}
                class="relative w-48 h-48 md:w-56 md:h-56 rounded-full shadow-xl object-cover border-4 border-white"
              />
            </div>
          </div>

          <!-- Name -->
          <h1 class="font-mono text-2xl font-bold text-slate-800 mb-3 text-center">
            {siteData.name}
          </h1>
          
          <!-- Positions -->
          <div class="mb-3 space-y-0.5 text-center">
            <p class="text-sm text-slate-700">Research Scientist, Data61, CSIRO</p>
            <p class="text-sm text-slate-700">Adjunct Fellow, QUT</p>
          </div>

          <!-- Contact -->
          <div class="text-center mb-4 space-y-1">
            <p class="text-sm text-slate-600">
              <span class="select-all">{siteData.email.replace('@', ' [at] ')}</span>
            </p>
            <p class="text-xs text-slate-500">{siteData.location}</p>
          </div>

          <!-- Social Links -->
          <div class="flex justify-center gap-3">
            <a 
              href={siteData.scholar} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 text-slate-600 hover:bg-amber-500 hover:text-white transition-all duration-300"
              title="Google Scholar"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
              </svg>
            </a>
            <a
              href={siteData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 text-slate-600 hover:bg-amber-500 hover:text-white transition-all duration-300"
              title="LinkedIn"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a
              href={siteData.cv}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 text-slate-600 hover:bg-amber-500 hover:text-white transition-all duration-300"
              title="Download CV (PDF)"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <polyline points="9 15 12 18 15 15"/>
              </svg>
            </a>
          </div>

          <!-- CV Download Button -->
          <div class="mt-4 flex justify-center">
            <a
              href={siteData.cv}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold shadow-sm transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download CV
            </a>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="md:col-span-2 space-y-16">
        <!-- About -->
        <section>
          <div
            class="prose prose-lg max-w-none text-slate-700 leading-relaxed"
            set:html={siteData.introduction}
          />

          <!-- Active research agenda -->
          <div class="mt-5 space-y-2.5 text-slate-700 leading-relaxed">
            <p class="text-sm font-semibold text-slate-600">Active Research Agenda</p>

            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-0.5 text-amber-600">
                <svg class="w-7 h-7" viewBox="0 0 128 96" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="28" y="32" width="72" height="22" rx="4" fill="currentColor" stroke="none"/>
                  <rect x="94" y="20" width="14" height="14" rx="2" fill="currentColor" stroke="none"/>
                  <circle cx="103" cy="24" r="2" fill="#ffffff" stroke="none"/>
                  <polyline points="36,54 46,68 40,86"/>
                  <polyline points="46,54 56,68 50,86"/>
                  <polyline points="82,54 72,68 78,86"/>
                  <polyline points="92,54 82,68 88,86"/>
                </svg>
              </span>
              <p class="text-sm">
                <strong>Robotic Foundation Models for Navigation</strong> at CSIRO, working across Vision Language Action models and robotic platforms (e.g. Boston Dynamics' Spot), with a focus on multimodal reasoning for navigation.
              </p>
            </div>

            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-0.5 text-amber-600">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="4"/>
                  <line x1="12" y1="2" x2="12" y2="5"/>
                  <line x1="12" y1="19" x2="12" y2="22"/>
                  <line x1="2" y1="12" x2="5" y2="12"/>
                  <line x1="19" y1="12" x2="22" y2="12"/>
                  <line x1="4.93" y1="4.93" x2="7.05" y2="7.05"/>
                  <line x1="16.95" y1="16.95" x2="19.07" y2="19.07"/>
                  <line x1="4.93" y1="19.07" x2="7.05" y2="16.95"/>
                  <line x1="16.95" y1="7.05" x2="19.07" y2="4.93"/>
                </svg>
              </span>
              <p class="text-sm">
                <strong>Solar-based Sensing</strong>: exploiting solar signals for complex sensing tasks, as in our <a href="/files/SolarTrack_paper.pdf" target="_blank" rel="noopener noreferrer" class="text-amber-600 hover:text-amber-500 transition-colors font-semibold">SolarTrack</a> paper (PerCom 2026).
              </p>
            </div>

            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-0.5 text-amber-600">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12a7 7 0 0 1 14 0"/>
                  <path d="M2 12a10 10 0 0 1 20 0"/>
                  <path d="M8 12a4 4 0 0 1 8 0"/>
                  <circle cx="12" cy="12" r="1" fill="currentColor"/>
                </svg>
              </span>
              <p class="text-sm">
                <strong>Radar Research</strong>, including radar-based place recognition, radar object segmentation, and related perception tasks (see our <a href="/files/HyperEcho_paper.pdf" target="_blank" rel="noopener noreferrer" class="text-amber-600 hover:text-amber-500 transition-colors font-semibold">HyperEcho</a> paper).
              </p>
            </div>

            <div class="flex items-start gap-3">
              <span class="flex-shrink-0 mt-0.5 text-amber-600">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                  <path d="M5 3v4"/>
                  <path d="M19 17v4"/>
                  <path d="M3 5h4"/>
                  <path d="M17 19h4"/>
                </svg>
              </span>
              <p class="text-sm">
                <strong>Multimodal Large Language Models reasoning</strong>: combining vision, language, and sensing to build agents that can perceive, reason, and act in the physical world.
              </p>
            </div>
          </div>

          <p class="mt-5 text-slate-700">
            <a
              href={siteData.cv}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-semibold text-amber-600 hover:text-amber-500 transition-colors"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
              View my CV (PDF) →
            </a>
          </p>
        </section>

        <!-- PhD Opportunity -->
        {siteData.phdOpportunity?.status !== "hidden" && (
          <section>
            {siteData.phdOpportunity.status === "open" ? (
              <div class="bg-gradient-to-r from-amber-50 to-orange-50 border-l-4 border-amber-500 rounded-lg p-5 shadow-sm">
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 mt-0.5">
                    <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-mono font-bold text-slate-800 mb-1">{siteData.phdOpportunity.title}</h3>
                    <p class="text-sm text-slate-700 mb-2" set:html={siteData.phdOpportunity.description} />
                    <p class="text-sm text-slate-600 mb-2 italic">{siteData.phdOpportunity.emailNote}</p>
                    <a 
                      href={siteData.phdOpportunity.url}
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-sm font-semibold text-amber-600 hover:text-amber-500 transition-colors"
                    >
                      View details & apply →
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <div class="bg-gradient-to-r from-slate-50 to-stone-100 border-l-4 border-slate-400 rounded-lg p-5 shadow-sm">
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 mt-0.5">
                    <svg class="w-6 h-6 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-mono font-bold text-slate-600 mb-1">{siteData.phdOpportunity.titleFilled}</h3>
                    <p class="text-sm text-slate-600 mb-2" set:html={siteData.phdOpportunity.descriptionFilled} />
                    <p class="text-sm text-slate-700 font-medium">{siteData.phdOpportunity.futureNote}</p>
                  </div>
                </div>
              </div>
            )}
          </section>
        )}

        <!-- News -->
        <section>
          <SectionHeading title="News" />
          <div class="space-y-3">
            {allNews.map((item, index) => (
              <NewsItem {...item} index={index} />
            ))}
          </div>
        </section>

        <!-- Publications -->
        <section>
          <SectionHeading title="Publications" />
          <p class="text-slate-700 leading-relaxed">
            My research focuses on Cyber-Physical Systems, including Radio-based Sensing, Machine Learning for IoT, and Optimal Transport methods. 
            I have published in top-tier venues such as <span class="font-semibold text-slate-800">SenSys</span>, <span class="font-semibold text-slate-800">PerCom</span>, <span class="font-semibold text-slate-800">ICCV</span>, <span class="font-semibold text-slate-800">IJCAI</span>, <span class="font-semibold text-slate-800">IEEE TPAMI</span>, <span class="font-semibold text-slate-800">IEEE Communications Surveys & Tutorials</span>, and <span class="font-semibold text-slate-800">Artificial Intelligence Review</span>.
            <a 
              href="/publications" 
              class="text-amber-600 hover:text-amber-500 font-medium transition-colors inline-flex items-center gap-1"
            >
              See all publications →
            </a>
          </p>
        </section>

        <!-- Students -->
        <section>
          <SectionHeading title="Students & Team" />
          <div class="space-y-2">
            {siteData.team.map((member) => (
              <div class="flex flex-wrap items-baseline gap-x-2 text-sm">
                <span class="font-semibold text-slate-800">{member.name}</span>
                <span class="text-slate-500">·</span>
                <span class="text-slate-600">{member.role}</span>
                <span class="text-slate-400 text-xs">({member.period})</span>
                {member.project && <span class="text-amber-600 text-xs" set:html={member.project} />}
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>
