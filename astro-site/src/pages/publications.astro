---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import SectionHeading from '../components/SectionHeading.astro';

import publicationsData from '../data/publications.json';

const publications = publicationsData.items;

// Group publications by year
const pubsByYear = publications.reduce((acc, pub) => {
  const year = pub.year;
  if (!acc[year]) acc[year] = [];
  acc[year].push(pub);
  return acc;
}, {} as Record<number, typeof publications>);

const years = Object.keys(pubsByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="Publications | Abdelwahed Khamis">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <!-- Header -->
    <div class="mb-10">
      <p class="text-slate-600">
        Below is a selection of my publications across radio-based sensing, optimal transport, and topological deep learning.
      </p>
    </div>

    <!-- Publications by Year -->
    {years.map((year) => (
      <section class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <span class="text-2xl font-serif font-bold text-slate-800">{year}</span>
          <div class="flex-1 h-px bg-stone-200"></div>
          <span class="text-sm text-slate-500">{pubsByYear[year].length} papers</span>
        </div>
        <div class="grid gap-6">
          {pubsByYear[year].map((pub, index) => (
            <PublicationCard {...pub} index={index} showImage={true} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

